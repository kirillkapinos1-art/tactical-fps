--!strict
-- Modular tactical weapon definitions, hitbox multipliers, and procedural model specs.

local NetworkTypes = require(script.Parent.NetworkTypes)

export type FireMode = NetworkTypes.FireMode
export type WeaponSlot = NetworkTypes.WeaponSlot
export type WeaponCategory = NetworkTypes.WeaponCategory
export type HitZone = NetworkTypes.HitZone

export type WeaponModelSpec = {
	BodyColor: Color3,
	AccentColor: Color3,
	MetalColor: Color3,
	ReceiverSize: Vector3,
	BarrelSize: Vector3,
	BarrelOffset: Vector3,
	HandguardSize: Vector3?,
	HandguardOffset: Vector3?,
	StockSize: Vector3?,
	StockOffset: Vector3?,
	GripSize: Vector3,
	GripOffset: Vector3,
	MagazineSize: Vector3,
	MagazineOffset: Vector3,
	OpticType: "Iron" | "Holo" | "Scope",
	OpticOffset: Vector3,
	AimOffset: Vector3,
	MuzzleOffset: Vector3,
	BoltSize: Vector3,
	BoltOffset: Vector3,
	HasSuppressor: boolean?,
}

export type WeaponDefinition = {
	Id: string,
	DisplayName: string,
	Description: string,
	Caliber: string,
	Category: WeaponCategory,
	Slot: WeaponSlot,
	FireModes: { FireMode },
	DefaultFireMode: FireMode,
	RPM: number,
	MagazineSize: number,
	ReserveMagazines: number,
	ChamberSupported: boolean,
	TacticalReloadTime: number,
	EmptyReloadTime: number,

	-- Damage & Ballistics
	BaseDamage: number,
	MinDamageMultiplier: number,
	DamageDropStart: number,
	DamageDropEnd: number,
	MuzzleVelocity: number,
	GravityMultiplier: number,
	DragCoefficient: number,
	MaxRange: number,
	PenetrationPower: number,
	SuppressionRadius: number,

	-- Spread (degrees)
	HipfireSpreadDeg: number,
	AdsSpreadDeg: number,
	MoveSpreadMultiplier: number,
	CrouchSpreadMultiplier: number,

	-- Camera & Pattern Recoil (degrees)
	RecoilPitchMin: number,
	RecoilPitchMax: number,
	RecoilYawMin: number,
	RecoilYawMax: number,
	RecoilRollMax: number,
	RecoilPattern: { Vector2 },
	RecoilSpringForce: number,
	RecoilSpringDamping: number,
	AdsRecoilMultiplier: number,
	CrouchRecoilMultiplier: number,

	-- Viewmodel & ADS
	ViewmodelOffset: CFrame,
	SprintOffset: CFrame,
	AdsEyeDistance: number,
	AdsFov: number,
	AdsSpeed: number,
	AdsSensitivityMultiplier: number,
	ViewmodelRecoilKick: Vector3,
	ViewmodelRecoilRot: Vector3,
	BoltKickDistance: number,
	SwayAmount: number,
	BobAmount: number,

	-- Audio tuning (synthesized / configurable SoundId)
	ShotPitch: number,
	ShotVolume: number,
	ShotSoundId: string,
	DryFireSoundId: string,
	ReloadSoundId: string,

	-- Procedural model geometry specification
	ModelSpec: WeaponModelSpec,
}

