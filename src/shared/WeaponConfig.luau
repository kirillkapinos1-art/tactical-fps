			BoltOffset = Vector3.new(0, 0.05, -0.02),
		},
	},
}

function WeaponConfig.GetWeapon(weaponId: string): WeaponDefinition?
	return Weapons[weaponId]
end

function WeaponConfig.GetAllWeapons(): { [string]: WeaponDefinition }
	return Weapons
end

function WeaponConfig.GetWeaponsBySlot(slot: WeaponSlot): { WeaponDefinition }
	local result: { WeaponDefinition } = {}
	for _, weaponId in ipairs(WeaponConfig.WeaponOrder) do
		local def = Weapons[weaponId]
		if def and def.Slot == slot then
			table.insert(result, def)
		end
	end
	return result
end

function WeaponConfig.IsValidWeapon(weaponId: string): boolean
	return Weapons[weaponId] ~= nil
end

return WeaponConfig
