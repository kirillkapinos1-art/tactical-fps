			HandguardOffset = nil,
			StockSize = nil,
			StockOffset = nil,
			GripSize = Vector3.new(0.13, 0.34, 0.20),
			GripOffset = Vector3.new(0, -0.34, 0.28),
			MagazineSize = Vector3.new(0.10, 0.30, 0.16),
			MagazineOffset = Vector3.new(0, -0.22, 0.18),
			OpticType = "Iron",
			OpticOffset = Vector3.new(0, 0.12, 0.22),
			AimOffset = Vector3.new(0, 0.14, 0.28),
			MuzzleOffset = Vector3.new(0, 0.04, -0.58),
